# ===========================================================================
# API MU (NestJS) — copiar como .env
# En el VPS: NODE_ENV=production. Con "development" se habilita /api/v2/seed,
# que BORRA cuentas y personajes.
# ===========================================================================
NODE_ENV=production
PORT=3000

# Key del BFF de Astro (header x-api-key). Da acceso a toda la API: no ponerla
# nunca en el launcher.
SECRET_API_KEY=cambiar-por-una-key-larga
# Key que viaja dentro del launcher. Solo sirve para /downloads.
LAUNCHER_API_KEY=cambiar-por-otra-key
# false = /downloads público, sin key
DOWNLOADS_REQUIRE_KEY=true
# Carpeta con downloads/ (por defecto ./public)
# PUBLIC_DIR=C:\API\public

JWT_SECRET=cambia-esta-clave-por-una-larga-y-segura
AUTH_RESET_SECRET=otra-clave-larga-para-links-de-reset

# URL pública del front (mails de recuperar contraseña, link de registro del launcher)
FRONTEND_URL=https://mucampana.com
# URL pública desde donde el launcher descarga /downloads (launcherUrl/updaterUrl)
MU_SERVER_URL=https://api.mucampana.com
# La versión del launcher se lee de los metadatos de downloads/Mu99bClassic/Client/launcher.exe.
# true = rollback: los launchers con versión DISTINTA (también mayor) bajan el publicado.
# Activarlo solo mientras se vuelve a una versión anterior; después volver a false.
LAUNCHER_ALLOW_DOWNGRADE=false

# Daemons del MU (health). En el VPS corren en la misma máquina.
MU_SERVER_HOST=127.0.0.1
MU_PORT_CONNECT=44405
MU_PORT_JOIN=55970
MU_PORT_GAME=55900
MU_PORT_DATA=55960

# Reverse proxy delante (Caddy en el mismo VPS sirve api.mucampana.com con HTTPS)
TRUST_PROXY=loopback

# Seguridad
RATE_LIMIT_PER_MINUTE=120
BLOCK_MAX_FAILURES=5
BLOCK_MINUTES=15

# Mailing
BREVO_API_KEY=
# Remitente de los mails (el dominio tiene que estar autenticado en Brevo)
MAIL_FROM=no-reply@mucampana.com
MAIL_FROM_NAME=Mu Campana

# Base de datos — en el VPS, local (el puerto 1433 no debe quedar expuesto)
DATABASE_URL="sqlserver://localhost:1433;database=MuOnline99b;user=sa;password=CAMBIAR;encrypt=true;trustServerCertificate=true;"
