@baseUrl = {{$dotenv API_BASE_URL}}
@apiKey = {{$dotenv SECRET_API_KEY}}

### Estado de la API y de los daemons del MU
# muServerDaemons: servicios de Windows (solo funciona en el VPS).
# muServer: puertos 44405 / 55970 / 55900 / 55960 en el host del MU.
GET {{baseUrl}}/health/readiness
x-api-key: {{apiKey}}

### Sin API key (debe responder 401)
# ⚠️ 5 fallos de key bloquean tu IP 15 minutos.
GET {{baseUrl}}/health/readiness
