# Variables para los .rest de esta carpeta (extensión REST Client).
# Copiar como docs/.env (está ignorado por git). La extensión usa el .env de
# la carpeta del .rest, así que este archivo tiene prioridad sobre api/.env.
#
# Dejá SIN comentar un solo bloque de destino.

# --- Destino: LOCAL ---
# API_BASE_URL=http://localhost:3000/api/v2
# SERVER_URL=http://localhost:3000

# --- Destino: VPS ---
API_BASE_URL=http://93.127.142.139/api/v2
SERVER_URL=http://93.127.142.139

# Keys del destino elegido
SECRET_API_KEY=
LAUNCHER_API_KEY=

# Cuentas de prueba
TEST_USERNAME=
TEST_PASSWORD=
TEST_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
